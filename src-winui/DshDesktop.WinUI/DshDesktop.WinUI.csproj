<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows native shell. It owns the window, the tray, menus and the three
    screens the shell draws itself; every piece of logic it needs (config, dsh
    discovery, launch lifecycle, URL policy, logging) comes from the Rust core
    through `dsh_ffi.dll`, a plain C ABI. Nothing in here re-implements that
    logic, and nothing in the Rust core knows this shell exists.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DshDesktop.WinUI</RootNamespace>
    <AssemblyName>dsh-desktop-winui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Taskbar, Alt+Tab, Start Menu and desktop shortcuts all take the icon from
         the executable, so it must be embedded (there is no manifest icon path). -->
    <ApplicationIcon>..\..\src-tauri\icons\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Unpackaged, self-contained: no MSIX, no Windows App Runtime preinstall.
         The trade is size, accepted deliberately (see docs/architecture.md). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Only ship satellite resources for the languages this shell actually shows.
         Without this the publish carries 87 culture folders (af-ZA, am-ET, ...),
         which is ~180 files of dead weight in every install. -->
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;en</SatelliteResourceLanguages>
    <!-- Trimming is off on purpose. It saved ~85 MB but kept breaking native
         integrations that the linker cannot see (the app's `.pri`, the WebView2
         WinRT projection, framework threading assemblies), each failure showing up
         only in the published build as a silent 0xC000027B at startup. The product
         budget is "not too big", not "as small as possible", so the shell ships the
         full self-contained output and uses the documented APIs as-is. -->
    <PublishTrimmed>false</PublishTrimmed>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Symbols and the crash-dump helper are not shipped. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Where the Rust bridge puts its cdylib; override with
         -p:DshFfiDirectory=... when building from a different profile. -->
    <DshFfiDirectory Condition="'$(DshFfiDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\target\release\</DshFfiDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- The split packages, not the `Microsoft.WindowsAppSDK` metapackage: the
         metapackage also drags in the AI/ML/Search/Widgets payload, which is
         ~38 MB of onnxruntime + DirectML this shell never loads. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>


  <ItemGroup>
    <None Include="$(DshFfiDirectory)dsh_ffi.dll"
          Link="dsh_ffi.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="Exists('$(DshFfiDirectory)dsh_ffi.dll')" />
  </ItemGroup>

  <Target Name="WarnWhenBridgeIsMissing" BeforeTargets="Build" Condition="!Exists('$(DshFfiDirectory)dsh_ffi.dll')">
    <Warning Text="dsh_ffi.dll was not found in $(DshFfiDirectory); build it with 'cargo build -p dsh-ffi --release'." />
  </Target>

  <!--
    `dotnet publish` for an unpackaged WinUI app forgets the app's own resource
    index (`<assembly>.pri`). Without it XAML resource lookup fails at startup
    with a stowed exception (0xC000027B) and no window ever appears, so it is
    copied explicitly. The WinAppSDK runtime pieces that also needed this when
    trimming was on come from the SDK when it is off.
  -->
  <Target Name="CopyShellPriToPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri"
                             RelativePath="$(TargetName).pri"
                             CopyToPublishDirectory="PreserveNewest"
                             Condition="Exists('$(TargetDir)$(TargetName).pri')" />
    </ItemGroup>
  </Target>

</Project>
