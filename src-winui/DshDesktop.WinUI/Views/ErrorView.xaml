<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DshDesktop.WinUI.Views.ErrorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- A failure is always a real screen: no white window, no silent exit. -->
    <ScrollViewer Padding="40" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="12">

            <TextBlock x:Name="TitleText" Style="{StaticResource ShellTitle}" Text="启动失败" />
            <TextBlock x:Name="BodyText" Style="{StaticResource ShellBody}" Text="dsh desktop 无法连接到 dsh。" />

            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource ShellBody}"
                Text="下一步" />

            <ItemsControl x:Name="StepList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="0,0,0,6"
                            Style="{StaticResource ShellCaption}"
                            Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource ShellCaption}"
                Text="可以在终端里手动验证：" />

            <TextBox
                x:Name="CommandText"
                FontFamily="Consolas"
                IsReadOnly="True"
                TextWrapping="Wrap" />

            <TextBox
                x:Name="DetailText"
                FontFamily="Consolas"
                FontSize="12"
                IsReadOnly="True"
                MaxHeight="220"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <StackPanel
                Margin="0,12,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="OnRetry"
                    Content="重试连接"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button Click="OnSettings" Content="打开设置" />
                <Button Click="OnOpenLogs" Content="打开日志目录" />
                <Button Click="OnCopyCommand" Content="复制命令" />
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                Margin="0,4,0,0"
                Style="{StaticResource ShellCaption}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
