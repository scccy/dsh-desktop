<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DshDesktop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The shell draws its own caption row (ADR-004): `ExtendsContentIntoTitleBar`
        hides the system title bar, Windows keeps drawing the real caption buttons
        on the right, and the row below is ours. The menus are *the shell's*
        actions — nothing here reaches into the hosted dsh page.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The row uses the page's sidebar fill, not the Mica tint, so it reads
            as the top of the hosted page instead of a second header glued above
            the page's own one.
        -->
        <Grid
            x:Name="AppTitleBar"
            Height="40"
            Background="{ThemeResource ShellTitleBarFillBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <MenuBar
                x:Name="AppMenu"
                Grid.Column="0"
                Height="32"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Background="Transparent">
                <MenuBarItem Title="应用">
                    <MenuFlyoutItem Click="OnMenuSettings" Text="打开设置…" />
                    <MenuFlyoutItem Click="OnMenuReconnect" Text="重试连接">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="R" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Click="OnMenuOpenLogs" Text="打开日志目录" />
                    <MenuFlyoutItem Click="OnMenuCheckUpdate" Text="检查 dsh 更新…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnMenuQuit" Text="退出">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Q" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="视图">
                    <MenuFlyoutItem Click="OnMenuReload" Text="刷新页面">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnMenuAbout" Text="关于 dsh desktop" />
                </MenuBarItem>
            </MenuBar>

            <!-- Only this strip drags the window, so menu items stay clickable
                 without passthrough regions. Double-click maximizes (框架处理). -->
            <Border
                x:Name="DragRegion"
                Grid.Column="1"
                Background="Transparent" />
        </Grid>

        <ContentControl
            x:Name="ScreenHost"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
