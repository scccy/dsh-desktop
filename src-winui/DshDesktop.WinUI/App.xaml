<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DshDesktop.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!--
                    The caption row sits directly on top of the hosted page, so it
                    must use the page's sidebar fill instead of the Mica tint:
                    Mica picks up the wallpaper and reads as a second, differently
                    coloured header glued to the page's own header row.
                    Light value sampled from the running page (#F9FAFB).
                -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShellTitleBarFillBrush" Color="#F9FAFB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShellTitleBarFillBrush" Color="#17181B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ShellTitleBarFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Shell-drawn pages only. The dsh web UI brings its own styles. -->
            <x:Double x:Key="ShellCardCornerRadius">8</x:Double>
            <Style x:Key="ShellTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ShellBody" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ShellCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
